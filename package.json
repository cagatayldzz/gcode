{
  "name": "vekro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/app.sh --dev",
    "build": "bash scripts/app.sh release --build",
    "update": "cargo upgrade --incompatible && cargo update",
    "release": "bash scripts/release.sh",
    "check": "bash scripts/app.sh --check",
    "icon": "bash scripts/app.sh --icon",
    "test": "bash scripts/tests/run.sh && cargo test --locked --workspace",
    "commit": "git add -A && oco --yes"
  }
}
